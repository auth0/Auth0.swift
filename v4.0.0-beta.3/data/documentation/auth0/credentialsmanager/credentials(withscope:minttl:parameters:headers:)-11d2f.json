als"}],"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"scope","content":[{"inlineContent":[{"type":"text","text":"Space-separated list of scope values to request when renewing credentials. Defaults to "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", which will ask for the same scopes that were requested on login."}],"type":"paragraph"}]},{"name":"minTTL","content":[{"inlineContent":[{"type":"text","text":"Minimum time in seconds the access token must remain valid to avoid being renewed. Defaults to "},{"type":"codeVoice","code":"60"},{"type":"text","text":"."}],"type":"paragraph"}]},{"name":"parameters","content":[{"inlineContent":[{"type":"text","text":"Additional parameters to use when renewing credentials."}],"type":"paragraph"}]},{"name":"headers","content":[{"inlineContent":[{"type":"text","text":"Additional headers to use when renewing credentials."}],"type":"paragraph"}]}]},{"content":[{"text":"Return Value","level":2,"anchor":"return-value","type":"heading"},{"inlineContent":[{"text":"The user’s credentials.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"text":"Usage","level":2,"anchor":"Usage","type":"heading"},{"syntax":"swift","code":["do {","    let credentials = try await credentialsManager.credentials()","    print(\"Obtained credentials: \\(credentials)\")","} catch {","    print(\"Failed with: \\(error)\")","}"],"type":"codeListing"},{"inlineContent":[{"text":"To avoid retrieving access tokens with too little time left, enforce a minimum TTL (in seconds):","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let credentials = try await credentialsManager.credentials(minTTL: 60)"],"type":"codeListing"},{"inlineContent":[{"text":"You can specify custom parameters or headers for the renewal request:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let credentials = try await credentialsManager.credentials(pa