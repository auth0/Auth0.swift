 case .failure(let error) = completion {","            print(\"Failed with: \\(error)\")","        }","    }, receiveValue: { credentials in","        print(\"Obtained credentials: \\(credentials)\")","    })","    .store(in: &cancellables)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"To avoid retrieving access tokens with too little time left, enforce a minimum TTL (in seconds):","type":"text"}],"type":"paragraph"},{"code":["credentialsManager","    .credentials(minTTL: 60)","    .sink(receiveCompletion: { print($0) },","          receiveValue: { print($0) })","    .store(in: &cancellables)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"You can specify custom parameters or headers for the renewal request:","type":"text"}],"type":"paragraph"},{"code":["credentialsManager","    .credentials(parameters: [\"key\": \"value\"],","                 headers: [\"key\": \"value\"])","    .sink(receiveCompletion: { print($0) },","          receiveValue: { print($0) })","    .store(in: &cancellables)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"When renewing credentials you can get a downscoped access token by requesting fewer scopes than were requested","type":"text"},{"text":" ","type":"text"},{"text":"on login. If you specify fewer scopes, the credentials will be renewed immediately, regardless of whether they","type":"text"},{"text":" ","type":"text"},{"text":"are expired or not.","type":"text"}],"type":"paragraph"},{"code":["credentialsManager","    .credentials(scope: \"openid offline_access\")","    .sink(receiveCompletion: { print($0) },","          receiveValue: { print($0) })","    .store(in: &cancellables)"],"type":"codeListing","syntax":"swift"},{"style":"note","name":"Requires","type":"aside","content":[{"inlineContent":[{"type":"text","text":"The scope "},{"type":"codeVoice","code":"offline_access"},{"type":"text","text":" to have been requested on login to get a refresh token from Auth0. If"},{"type":"text","text":" "},{"type":"text","text":"the credentials are expired and there is no refresh token, the subscription will complete with a"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.auth0.Auth0\/documentation\/Auth0\/CredentialsManagerError\/noRefreshToken","isActive":true},{"type":"text","text":" error."}],"type":"paragraph"}]},{"style":"warning","name":"Warning","type":"aside","content":[{"inlineContent":[{"type":"text","text":"Do not call "},{"type":"codeVoice","code":"store(credentials:)"},{"type":"text","text":" afterward. The Credentials Manager automatically persists the"},{"type":"text","text":" "},{"type":"text","text":"renewed credentials. Since this method is thread-safe and "},{"type":"reference","identifier":"doc:\/\/com.auth0.Auth0\/documentation\/Auth0\/CredentialsManager\/store(credentials:)","isActive":true},{"type":"text","text":" is not, calling it anyway can"},{"type":"text","text":" "},{"type":"text","text":"cause concurrency issues."}],"type":"paragraph"}]},{"style":"important","name":"Important","type":"aside","content":[{"inlineContent":[{"type":"text","text":"To ensure that no concurrent renewal requests get made, do not call this method from multiple"},{"type":"text","text":" "},{"type":"text","text":"Credentials Manager instances. The Credentials Manager cannot synchronize requests across instances."}],"type":"paragraph"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/auth0\/credentialsmanager\/credentials(withscope:minttl:parameters:headers:)-7xldm"]}],"references":{"doc://com.auth0.Auth0/documentation/Auth0/RefreshTokens":{"abstract":[],"role":"article","url":"\/documentation\/auth0\/refreshtokens","title":"Refresh Tokens: Common Errors","identifier":"doc:\/\/com.auth0.Auth0\/documentation\/Auth0\/RefreshTokens","kind":"article","type":"topic"},"doc://com.auth0.Auth0/documentation/Auth0":{"type":"topic","kind":"symbol","role":"collection","title":