ntent":[{"inlineContent":[{"type":"text","text":"Last name of the user. Defaults to "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}],"type":"paragraph"}]},{"name":"nickname","content":[{"inlineContent":[{"text":"Preferred nickname of the user. Defaults to ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"name":"picture","content":[{"inlineContent":[{"text":"URL pointing to the user’s profile picture. Defaults to ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"name":"userMetadata","content":[{"inlineContent":[{"text":"Additional user metadata as key-value pairs. Defaults to ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"name":"connection","content":[{"inlineContent":[{"text":"Name of the database connection where the user will be created. If a connection name is not specified, your tenant’s default directory will be used.","type":"text"}],"type":"paragraph"}]},{"name":"organization","content":[{"inlineContent":[{"text":"Identifier of an organization the user is a member of.","type":"text"}],"type":"paragraph"}]}]},{"content":[{"text":"Return Value","type":"heading","level":2,"anchor":"return-value"},{"inlineContent":[{"text":"A request that will yield a passkey signup challenge.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"inlineContent":[{"text":"You need to provide at least one user identifier when requesting the challenge, along with an optional user","type":"text"},{"text":" ","type":"text"},{"text":"display name, and an optional database connection name. If a connection name is not specified, your tenant’s","type":"text"},{"text":" ","type":"text"},{"text":"default directory will be used.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"By default, database connections require a valid ","type":"text"},{"code":"email","type":"codeVoice"},{"text":". If you have enabled ","type":"text"},{"identifier":"https:\/\/auth0.com\/docs\/authenticate\/database-connections\/activate-and-configure-attributes-for-flexible-identifiers","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"for your database connection, you may use any combination of ","type":"text"},{"code":"email","type":"codeVoice"},{"text":", ","type":"text"},{"code":"phoneNumber","type":"codeVoice"},{"text":", or ","type":"text"},{"code":"username","type":"codeVoice"},{"text":". These user","type":"text"},{"text":" ","type":"text"},{"text":"identifiers can be required or optional and must match your Flexible Identifiers configuration.","type":"text"}],"type":"paragraph"},{"text":"Usage","type":"heading","level":2,"anchor":"Usage"},{"type":"codeListing","syntax":"swift","code":["Auth0","    .authentication()","    .passkeySignupChallenge(email: \"support@auth0.com\",","                            name: \"John Appleseed\",","                            givenName: \"John\",","                            familyName: \"Appleseed\",","                            userMetadata: [\"signup_source\": \"ios_app\"],","                            connection: \"Username-Password-Authentication\",","                            organization: \"org_aaAA1aa11aAAAA1a\")","    .start { result in","        switch result {","        case .success(let signupChallenge):","            print(\"Obtained signup challenge: \\(signupChallenge)\")","        case .failure(let error):","            print(\"Failed with: \\(error)\")","        }","    }"]},{"inlineContent":[{"text":"Use the challenge with ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/documentation\/authenticationservices\/asauthorizationplatformpublickeycredentialprovider","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"from the ","type":"text"},{"code":"AuthenticationServices","type":"codeVoice"},{"text":" framework to generate a new passkey credential. It will be delivered through the ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/documentation\/authenticationservices\/asauthorizationcontrollerdelegate","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"delegate. Check out ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/documentation\/authenticationservices\/supporting-passkeys#Register-a-new-account-on-a-service","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"to learn more.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let credentialProvider = ASAuthorizationPlatformPublicKeyCredentialProvider(","    relyingPartyIdentifier: signupChallenge.relyingPartyId",")","","let request = credentialProvider.createCredentialRegistrationRequest(","    challenge: signupChallenge.challengeData,","    name: signupChallenge.userName,","    userID: signupChallenge.userId",")","","let authController = ASAuthorizationController(authorizationRequests: [request])","authController.delegate = self \/\/ ASAuthorizationControllerDelegate","authController.presentationContextProvider = self","authController.performRequests()"]},{"inlineContent":[{"text":"Then, call ","type":"text"},{"identifier":"doc:\/\/com.auth0.Auth0\/documentation\/Auth0\/Authentication\/login(passkey:challenge:connection:audience:scope:organization:verification:)","isActive":true,"type":"reference"},{"text":" with the created","type":"text"},{"text":" ","type":"text"},{"text":"passkey credential and the challenge to log the new user in.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If ","type":"text"},{"identifier":"doc:\/\/com.auth0.Auth0\/documentation\/Auth0\/PasskeySignupChallenge\/verificationRequired","isActive":true,"type":"reference"},{"text":" is non-nil, the server delivers a one-time code to each","type":"text"},{"text":" ","type":"text"},{"text":"listed identifier, a