n\/Auth0","doc:\/\/com.auth0.Auth0\/documentation\/Auth0\/Authentication"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"ssoExchange"},{"kind":"text","text":"("},{"kind":"externalParam","text":"withRefreshToken"},{"kind":"text","text":" "},{"kind":"internalParam","text":"refreshToken"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"any"},{"kind":"text","text":" "},{"preciseIdentifier":"s:5Auth016TokenRequestableP","kind":"typeIdentifier","text":"TokenRequestable","identifier":"doc:\/\/com.auth0.Auth0\/documentation\/Auth0\/TokenRequestable"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:5Auth014SSOCredentialsV","kind":"typeIdentifier","text":"SSOCredentials","identifier":"doc:\/\/com.auth0.Auth0\/documentation\/Auth0\/SSOCredentials"},{"kind":"text","text":", "},{"preciseIdentifier":"s:5Auth019AuthenticationErrorV","kind":"typeIdentifier","text":"AuthenticationError","identifier":"doc:\/\/com.auth0.Auth0\/documentation\/Auth0\/AuthenticationError"},{"kind":"text","text":">"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The refresh token."}],"type":"paragraph"}],"name":"refreshToken"}],"kind":"parameters"},{"content":[{"level":2,"type":"heading","anchor":"return-value","text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A request that will yield SSO credentials."}]}],"kind":"content"},{"content":[{"anchor":"Usage","text":"Usage","type":"heading","level":2},{"type":"codeListing","code":["Auth0","    .authentication()","    .ssoExchange(refreshToken: credentials.refreshToken)","    .start { result in","        switch result {","        case .success(let ssoCredentials):","            print(\"Obtained new SSO credential