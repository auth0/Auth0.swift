pp is using. Otherwise, the "},{"code":"\/authorize","type":"codeVoice"},{"type":"text","text":" endpoint will not receive the cookie. If your website"},{"type":"text","text":" "},{"type":"text","text":"is using the provided Auth0 domain (like "},{"code":"example.us.auth0.com","type":"codeVoice"},{"type":"text","text":"), set the cookie’s domain to this value. On the"},{"type":"text","text":" "},{"type":"text","text":"other hand, if your website is using a custom domain, use this value instead."}],"type":"paragraph"}]},{"style":"note","name":"Note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"Chain ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.auth0.Auth0\/documentation\/Auth0\/TokenRequest\/validateClaims()","type":"reference"},{"text":" before calling ","type":"text"},{"code":"start(_:)","type":"codeVoice"},{"text":" to validate the ID token. See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.auth0.Auth0\/documentation\/Auth0\/IDTokenValidation","type":"reference"},{"text":".","type":"text"}]}]}],"kind":"content"}],"kind":"symbol","references":{"doc://com.auth0.Auth0/documentation/Auth0/AuthenticationError":{"identifier":"doc:\/\/com.auth0.Auth0\/documentation\/Auth0\/AuthenticationError","type":"topic","url":"\/documentation\/auth0\/authenticationerror","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"AuthenticationError","kind":"identifier"}],"title":"AuthenticationError","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AuthenticationError"}],"abstract":[{"type":"text","text":"Represents an error during a request to the Auth0 Authentication API."}]},"doc://com.auth0.Auth0/documentation/Auth0/TokenRequest/validateClaims()":{"type":"topic","url":"\/documentation\/auth0\/tokenrequest\/validateclaims()","role":"symbol","identifier":"doc:\/\/com.auth0.Auth0\/documentation\/Auth0\/TokenRequest\/validateClaims()","title":"validateClaims()","abstract":[