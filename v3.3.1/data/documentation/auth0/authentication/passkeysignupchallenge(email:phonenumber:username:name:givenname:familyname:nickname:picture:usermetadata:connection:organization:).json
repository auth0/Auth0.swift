il"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Phone number of the user. Defaults to "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"."}]}],"name":"phoneNumber"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Username of the user. Defaults to "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"."}]}],"name":"username"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Display name of the user. Defaults to "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"."}]}],"name":"name"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"First name of the user. Defaults to "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"."}]}],"name":"givenName"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Last name of the user. Defaults to "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"."}]}],"name":"familyName"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Preferred nickname of the user. Defaults to "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"."}]}],"name":"nickname"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"URL pointing to the user’s profile picture. Defaults to "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"."}]}],"name":"picture"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Additional user metadata as key-value pairs. Defaults to "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"."}]}],"name":"userMetadata"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Name of the database connection where the user will be created. If a connection name is not specified, your tenant’s default directory will be used."}]}],"name":"connection"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Identifier of an organization the user is a member of."}]}],"name":"organization"}]},{"kind":"content","content":[{"anchor":"return-value","text":"Return Value","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"A request that will yield a passkey signup challenge."}],"type":"paragraph"}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"You need to provide at least one user identifier when requesting the challenge, along with an optional user"},{"type":"text","text":" "},{"type":"text","text":"display name, and an optional database connection name. If a connection name is not specified, your tenant’s"},{"type":"text","text":" "},{"type":"text","text":"default directory will be used."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"By default, database connections require a valid "},{"code":"email","type":"codeVoice"},{"type":"text","text":". If you have enabled "},{"type":"reference","identifier":"https:\/\/auth0.com\/docs\/authenticate\/database-connections\/activate-and-configure-attributes-for-flexible-identifiers","isActive":true},{"type":"text","text":" "},{"type":"text","text":"for your database connection, you may use any combination of "},{"code":"email","type":"codeVoice"},{"type":"text","text":", "},{"code":"phoneNumber","type":"codeVoice"},{"type":"text","text":", or "},{"code":"username","type":"codeVoice"},{"type":"text","text":". These user"},{"type":"text","text":" "},{"type":"text","text":"identifiers can be required or optional and must match your Flexible Identifiers configuration."}],"type":"paragraph"},{"anchor":"Usage","text":"Usage","type":"heading","level":2},{"syntax":"swift","code":["Auth0","    .authentication()","    .passkeySignupChallenge(email: \"support@auth0.com\",","                            name: \"John Appleseed\",","                            givenName: \"John\",","                            familyName: \"Appleseed\",","                            userMetadata: [\"signup_source\": \"ios_app\"],","                            connection: \"Username-Password-Authentication\",","                            organization: \"org_aaAA1aa11aAAAA1a\")","    .start { result in","        switch result {","        case .success(let signupChallenge):","            print(\"Obtained signup challenge: \\(signupChallenge)\")","        case .failure(let error):","            print(\"Failed with: \\(error)\")","        }","    }"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Use the challenge with "},{"isActive":true,"type":"reference","identifier":"https:\/\/developer.apple.com\/documentation\/authenticationservices\/asauthorizationplatformpublickeycredentialprovider"},{"type":"text","text":" "},{"type":"text","text":"from the "},{"code":"AuthenticationServices","type":"codeVoice"},{"type":"text","text":" framework to generate a new passkey credential. It will be delivered through the "},{"isActive":true,"type":"reference","identifier":"https:\/\/developer.apple.com\/documentation\/authenticationservices\/asauthorizationcontrollerdelegate"},{"type":"text","text":" "},{"type":"text","text":"delegate. Check out "},{"isActive":true,"type":"reference","identifier":"https:\/\/developer.apple.com\/documentation\/authenticationservices\/supporting-passkeys#Register-a-new-account-on-a-service"},{"type":"text","text":" "},{"type":"text","text":"to learn more."}],"type":"paragraph"},{"syntax":"swift","code":["let credentialProvider = ASAuthorizationPlatformPublicKeyCredentialProvider(","    relyingPartyIdentifier: signupChallenge.relyingPartyId",")","","let request = credentialProvider.createCredentialRegistrationRequest(","    challenge: signupChallenge.challengeData,","    name: signupChallenge.userName,","    userID: signupChallenge.userId",")","","let authController = ASAuthorizationController(authorizationRequests: [request])","authController.delegate = self \/\/ ASAuthorizationControllerDelegate","authController.presentationContextProvider = self","authController.performRequests()"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Then, call "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.auth0.Auth0\/documentation\/Auth0\/Authentication\/login(passkey:challenge:connection:audience:scope:organization:verification:)"},{"type":"text","text":" with the created"},{"type":"text","text":" "},{"type":"text","text":"passkey credential and the challenge to log the new user in."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.auth0.Auth0\/documentation\/Auth0\/PasskeySignupChallenge\/verificationRequired"},{"type":"text","text":" is non-nil, the server delivers a one-time code to each"},{"type":"text","text":" "},{"type":"text","text":"listed identifier, and the codes must be sent along with the passkey in"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.auth0.Auth0\/documentation\/Auth0\/Authentication\/login(passkey:challenge:connection:audience:scope:organization:verification:)"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"To start over — for example when the user asks for new codes — request a new signup challenge. A new challenge"},{"type":"text","text":" "},{"type":"text","text":"comes with its own "},{"code":"auth_session","type":"codeVoice"},{"type":"text","text":" and challenge data, so create a new passkey credential from it as well; a"},{"type":"text","text":" "},{"type":"text","text":"passkey created for a previous challenge can’t be used with it."}],"type":"paragraph"}]}],"references":{"https://developer.apple.com/documentation/authenticationservices/supporting-passkeys#Register-a-new-account-on-a-service":{"title":"Supporting passkeys","type":"link","titleInlineContent":[{"type":"text","text":"Supporting passkeys"}],"identifier":"https:\/\/developer.apple.com\/documentation\/authenticationservices\/supportin