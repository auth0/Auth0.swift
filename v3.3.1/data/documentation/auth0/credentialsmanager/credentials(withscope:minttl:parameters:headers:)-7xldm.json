ues.","type":"text"}],"type":"paragraph"}],"name":"Warning","style":"warning"},{"type":"aside","content":[{"inlineContent":[{"text":"To ensure that no concurrent renewal requests get made, do not call this method from multiple","type":"text"},{"text":" ","type":"text"},{"text":"Credentials Manager instances. The Credentials Manager cannot synchronize requests across instances.","type":"text"}],"type":"paragraph"}],"name":"Important","style":"important"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"paths":["\/documentation\/auth0\/credentialsmanager\/credentials(withscope:minttl:parameters:headers:)-7xldm"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Retrieves credentials from the Keychain and automatically renews them using the refresh token if the access"},{"type":"text","text":" "},{"type":"text","text":"token is expired. Otherwise, the subscription will complete with the retrieved credentials as they are still"},{"type":"text","text":" "},{"type":"text","text":"valid. Renewed credentials will be stored in the Keychain. "},{"type":"strong","inlineContent":[{"text":"This method is thread-safe","type":"text"}]},{"type":"text","text":"."}],"seeAlsoSections":[{"identifiers":["https:\/\/auth0.com\/docs\/secure\/tokens\/refresh-tokens","https:\/\/auth0.com\/docs\/api\/authentication\/refresh-token\/refresh-token","doc:\/\/com.auth0.Auth0\/documentation\/Auth0\/RefreshTokens"],"title":"Related Documentation","anchor":"Related-Documentation"}],"metadata":{"title":"credentials(withScope:minTTL:parameters:headers:)","externalID":"s:5Auth018CredentialsManagerV11credentials9withScope6minTTL10parameters7headers7Combine12AnyPublisherVyAA0B0CAA0bC5ErrorVGSSSg_SiSDySSypGSDyS2SGtF","role":"symbol","modules":[{"name":"Auth0"}],"roleHeading":"Instance Method","extendedModule":"Auth0","symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"credentials"},{"kind":"t