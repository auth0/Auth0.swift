ive":true,"type":"reference"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"- "},{"type":"strong","inlineContent":[{"type":"text","text":"Retry after a wrong code:"}]},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.auth0.Auth0\/documentation\/Auth0\/AuthenticationError\/passkeyVerificationRequired","isActive":true},{"type":"text","text":", from the error of the previous call when "},{"type":"reference","identifier":"doc:\/\/com.auth0.Auth0\/documentation\/Auth0\/AuthenticationError\/isPasskeyVerificationRetryable","isActive":true},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":". It lists only the identifiers that are still unverified."}]},{"type":"codeListing","syntax":null,"code":["         An empty array means that verification is not enabled, or not required for any identifier: nothing is validated."]}],"name":"verificationRequired"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The session of the signup. Use "},{"type":"reference","identifier":"doc:\/\/com.auth0.Auth0\/documentation\/Auth0\/PasskeySignupChallenge\/authenticationSession","isActive":true},{"type":"text","text":" on the first attempt, and "},{"type":"reference","identifier":"doc:\/\/com.auth0.Auth0\/documentation\/Auth0\/AuthenticationError\/passkeyAuthSession","isActive":true},{"type":"text","text":" on a retry (Auth0 echoes the same session back)."}]}],"name":"authSession"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Name of the database connection where the user will be created. If a connection name is not specified, your tenant’s default directory will be used."}]}],"name":"connection"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"API Identifier that your application is requesting access to. Defaults to "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}]}],"name":"audience"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Space-separated list of requested scope values. Defaults to "},{"type":"codeVoice","code":"openid profile email"},{"type":"text","text":"."}]}],"name":"scope"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Identifier of an organization the user is a member of."}]}],"name":"organization"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"One-time codes that verify ownership of the identifiers, keyed by "},{"type":"reference","identifier":"doc:\/\/com.auth0.Auth0\/documentation\/Auth0\/PasskeyVerificationMethod","isActive":true},{"type":"text","text":". For example, "},{"type":"codeVoice","code":"[.email: \"123456\", .phone: \"654321\"]"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Every identifier in "},{"type":"codeVoice","code":"verificationRequired"},{"type":"text","text":" needs a non-empty code. If a code is missing ("},{"type":"codeVoice","code":"Missing required parameter: verification.email"},{"type":"text","text":") or is an empty string, or only whitespace ("},{"type":"codeVoice","code":"\"verification.email\" is not allowed to be empty"},{"type":"text","text":", with "},{"type":"codeVoice","code":"verification.phone"},{"type":"text","text":" for the phone), the request fails with an "},{"type":"codeVoice","code":"invalid_request"},{"type":"text","text":" error before it is sent, naming the first identifier of "},{"type":"codeVoice","code":"verificationRequired"},{"type":"text","text":" with a problem."},{"type":"text","text":" "},{"type":"text","text":"The request is not sent in that case, so the session is unchanged: provide the code and call again with the same passkey credential."},{"type":"text","text":" "},{"type":"text","text":"Codes for identifiers that are not in "},{"type":"codeVoice","code":"verificationRequired"},{"type":"text","text":" are not validated, and an empty dictionary is never sent. Defaults to an empty dictionary,