xt"},{"text":" ","type":"text"},{"text":"display name, and an optional database connection name. If a connection name is not specified, your tenant’s","type":"text"},{"text":" ","type":"text"},{"text":"default directory will be used.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"By default, database connections require a valid ","type":"text"},{"type":"codeVoice","code":"email"},{"text":". If you have enabled ","type":"text"},{"type":"reference","identifier":"https:\/\/auth0.com\/docs\/authenticate\/database-connections\/activate-and-configure-attributes-for-flexible-identifiers","isActive":true},{"text":" ","type":"text"},{"text":"for your database connection, you may use any combination of ","type":"text"},{"type":"codeVoice","code":"email"},{"text":", ","type":"text"},{"type":"codeVoice","code":"phoneNumber"},{"text":", or ","type":"text"},{"type":"codeVoice","code":"username"},{"text":". These user","type":"text"},{"text":" ","type":"text"},{"text":"identifiers can be required or optional and must match your Flexible Identifiers configuration.","type":"text"}],"type":"paragraph"},{"anchor":"Usage","level":2,"type":"heading","text":"Usage"},{"code":["Auth0","    .authentication()","    .passkeySignupChallenge(email: \"support@auth0.com\",","                            name: \"John Appleseed\",","                            givenName: \"John\",","                            familyName: \"Appleseed\",","                            userMetadata: [\"signup_source\": \"ios_app\"],","                            connection: \"Username-Password-Authentication\",","                            organization: \"org_aaAA1aa11aAAAA1a\")","    .start { result in","        switch result {","        case .success(let signupChallenge):","            print(\"Obtained signup challenge: \\(signupChallenge)\")","        case .failure(let error):","            print(\"Failed with: \\(error)\")","        }","    }"],"type":"codeListing","syntax":"swift"},{"inlineConten